# Copy to secrets.env (gitignored) and fill in real values, then: source secrets.env
#
# EASIEST FOR LEARNING: just run `az login` in your terminal and you can skip
# the ARM_* Service Principal vars below entirely — the azurerm provider and the
# state backend will both use your CLI session. You still need the subscription id.

# Your Azure subscription. Terraform maps TF_VAR_subscription_id -> var.subscription_id
# Find it with: az account show --query id -o tsv
export TF_VAR_subscription_id="00000000-0000-0000-0000-000000000000"

# ---- Service Principal (only needed for CI/CD or non-interactive auth) ----
# Create one with:
#   az ad sp create-for-rbac --name hivebox-tf --role Contributor \
#     --scopes /subscriptions/<SUBSCRIPTION_ID>
# Then export the returned values:
# export ARM_CLIENT_ID="appId"
# export ARM_CLIENT_SECRET="password"
# export ARM_TENANT_ID="tenant"
# export ARM_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
